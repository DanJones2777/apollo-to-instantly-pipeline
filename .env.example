APOLLO_API_KEY=
REOON_API_KEY=
BOUNCEBAN_API_KEY=

# Slack Email Cleaner Bot — get these from https://api.slack.com/apps
SLACK_BOT_TOKEN=xoxb-your-bot-token-here
SLACK_APP_TOKEN=xapp-your-app-level-token-here
SLACK_CHANNEL_ID=C0XXXXXXXXX
INSTANTLY_API_KEY=

# Optional
REOON_MAX_WAIT_SECONDS=1800
REOON_POLL_INTERVAL_SECONDS=15
BOUNCEBAN_MAX_WAIT_SECONDS=600
BOUNCEBAN_POLL_INTERVAL_SECONDS=15
INSTANTLY_SKIP_IF_IN_WORKSPACE=true
INSTANTLY_CAMPAIGN_DURATION_DAYS=30
INSTANTLY_FAIL_FAST=false
INSTANTLY_TIMEZONE=America/Chicago
INSTANTLY_SCHEDULE_FROM=08:00
INSTANTLY_SCHEDULE_TO=10:00
INSTANTLY_EMAIL_SUBJECT=New role at a startup!
INSTANTLY_EMAIL_BODY=<p>Hi {{first_name}},</p><p>{{personalization}}</p>
